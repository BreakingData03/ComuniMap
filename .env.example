# Copie para .env e ajuste. Todos têm padrão: o compose sobe sem este arquivo.

POSTGRES_USER=comunimap
POSTGRES_PASSWORD=comunimap
POSTGRES_DB=comunimap

# Portas no host (fora do padrão de propósito)
API_PORT=8010
DB_PORT=5442
REDIS_PORT=6389

# Assinatura dos tokens de login. Em produção, gere um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-before-deploying

# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# Termos que seguram um registro na moderação automática (separados por vírgula)
MODERATION_BLOCKLIST=
