# URL pública da API. Vazio = mesma origem (em dev o Vite faz proxy de /api e /media).
# Em produção com front em outro domínio (ex.: GitHub Pages): https://api.seudominio.com.br
VITE_API_BASE_URL=

# Chave gratuita dos basemaps do CARTO (https://carto.com/basemaps/apikey).
# Com ela o mapa usa o tema Dark Matter; sem ela, OpenStreetMap com filtro escuro.
VITE_CARTO_API_KEY=

# true = roda sem API, com dados no navegador do visitante (vitrine do GitHub Pages).
VITE_DEMO_MODE=false

# Destino do proxy do Vite em desenvolvimento.
VITE_DEV_API_TARGET=http://localhost:8010
